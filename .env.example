# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. Server-only — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte AES-256 key for encrypting client banking details, base64-encoded.
# Generate one with: openssl rand -base64 32
BANKING_ENCRYPTION_KEY=

# Delivery channel for setup/password-reset OTP codes: "sms" or "whatsapp".
# Keep this on "sms" until the WhatsApp Business API sender is configured.
OTP_CHANNEL=sms

# Required once SMS/WhatsApp sending is wired up in Supabase Auth (Twilio).
# Not read directly by this app — configured in the Supabase dashboard
# under Authentication -> Providers -> Phone.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGE_SERVICE_SID=

# Transactional email (Resend) — for future email-based notifications/reports.
# RESEND_API_KEY=

# --- Staff WhatsApp query bot (POST /api/whatsapp) ---
# The Twilio WhatsApp sender, e.g. "whatsapp:+14155238886" for the sandbox.
# TWILIO_WHATSAPP_FROM=whatsapp:+
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Exact public URL Twilio calls (used to verify its signature). Set it if the
# app sits behind a proxy/custom domain, e.g. https://<domain>/api/whatsapp
# WHATSAPP_WEBHOOK_URL=
# ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5).
# WHATSAPP_BOT_MODEL=
